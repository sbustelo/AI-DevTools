{
    "categories": {
        "disabled": {
            "label": "Disabled (_*)",
            "prefix_state": "disabled",
            "default_excluded": true
        },
        "discard": {
            "label": "Discarded (_🗑️ / __)",
            "prefix_state": "discard",
            "default_excluded": true
        },
        "backup": {
            "label": "Backups (_📦)",
            "prefix_state": "backup",
            "default_excluded": true
        },
        "hidden_dot": {
            "label": "Hidden / Dotfiles (.* / .git)",
            "pattern": "/^\\./",
            "default_excluded": true
        },
        "vendor_deps": {
            "label": "Dependencies (node_modules / vendor)",
            "pattern": "/^(node_modules|vendor)$/i",
            "default_excluded": true
        },
        "build_cache": {
            "label": "Build / Logs / Cache (dist / logs / tmp)",
            "pattern": "/^(dist|build|logs|cache|tmp)$/i",
            "default_excluded": true
        },
        "j0_compiled": {
            "label": "j0 Compiled Bundles (.js / .css)",
            "j0_artifact": "compiled",
            "default_excluded": true
        },
        "j0_minified": {
            "label": "j0 Minified Bundles (.min.js / .min.css)",
            "j0_artifact": "minified",
            "default_excluded": true
        }
    },
    "j0_pragmas": {
        "compiled": [
            "/*! j0 compiled",
            "/*! j0 c*/"
        ],
        "minified": [
            "/*! j0 minified",
            "/*! j0 m*/"
        ]
    },
    "binary_extensions": [
        "png",
        "jpg",
        "jpeg",
        "gif",
        "webp",
        "svg",
        "ico",
        "pdf",
        "zip",
        "tar",
        "gz",
        "sqlite",
        "db",
        "woff",
        "woff2",
        "ttf"
    ]
}
